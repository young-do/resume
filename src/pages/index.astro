---
import '../css/index-page.css';
import resumeMarkdown from '../../RESUME.md?raw';
import { parseSummaryMarkdown } from '../lib/summaryMarkdown';

const isProd = import.meta.env.PROD;
const { meta, introHtml, sections, skills } = await parseSummaryMarkdown(resumeMarkdown);
const findSection = (title: string) => sections.find((section) => section.title === title);
const sectionClassName = (title: string) => title.toLowerCase().replace(/\s+/g, '-');
const sidebarSections = ['Contact', 'Education'].map(findSection).filter((section) => section !== undefined);
const mainSections = ['Work Experience', 'Other Experience']
  .map(findSection)
  .filter((section) => section !== undefined);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>이력서 - 조영도</title>
    <link rel="icon" type="image/x-icon" href={import.meta.env.BASE_URL + '/favicon.ico'} />
    <meta name="generator" content={Astro.generator} />

    <!-- Global site tag (gtag.js) - Google Analytics -->
    {
      isProd && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2LDBHRPKXL" />
          <script is:inline>
            window.dataLayer = window.dataLayer || []; function gtag() {dataLayer.push(arguments)}; gtag("js", new
            Date()); gtag("config", "G-2LDBHRPKXL");
          </script>

          <script is:inline src="https://cdn.ingest-lr.com/LogRocket.min.js" crossorigin="anonymous" />
          <script is:inline>window.LogRocket && window.LogRocket.init('rbbdow/test');</script>
        </>
      )
    }
  </head>
  <body>
    <main class="resume-page">
      <header class="resume-hero">
        <div class="hero-header-row">
          <div class="hero-title-area">
            <h1>{meta.name}</h1>
            {meta.role && <p class="hero-role">{meta.role}</p>}
          </div>
          {meta.updated && <p class="resume-updated">최근 업데이트: {meta.updated}</p>}
        </div>
        
        <div class="resume-intro" set:html={introHtml} />
      </header>

      <div class="resume-layout">
        <aside class="resume-sidebar">
          {
            sidebarSections.map((section) => (
              <section class={`resume-section ${sectionClassName(section.title)}-section`}>
                <h2>{section.title}</h2>
                <div class="section-content-html" set:html={section.html} />
              </section>
            ))
          }

          {
            skills.length > 0 && (
              <section class="resume-section skills-section">
                <h2>Skills</h2>
                <div class="skills-container">
                  {skills.map((skillGroup) => (
                    <div class="skill-group">
                      <h3>{skillGroup.category}</h3>
                      <div class="skill-badges">
                        {skillGroup.items.map((item) => (
                          <span class="skill-badge">{item}</span>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            )
          }
        </aside>

        <div class="resume-main">
          {
            mainSections.map((section) => (
              <section class={`resume-section ${sectionClassName(section.title)}-section`}>
                <h2>{section.title}</h2>
                <div class="section-content" set:html={section.html} />
              </section>
            ))
          }
        </div>
      </div>
    </main>
  </body>
</html>
