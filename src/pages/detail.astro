---
import '../css/detail-page.css';
import Accordion from '../components/Accordion.astro';
import Progressbar from '../components/Progressbar.astro';
import resumeDetailMarkdown from '../../RESUME_DETAIL.md?raw';
import { parseResumeMarkdown } from '../lib/markdown';

const isProd = import.meta.env.PROD;
const { meta, sections } = await parseResumeMarkdown(resumeDetailMarkdown);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>상세 이력서 - 조영도</title>
    <link rel="icon" type="image/x-icon" href={import.meta.env.BASE_URL + '/favicon.ico'} />
    <meta name="generator" content={Astro.generator} />

    {
      isProd && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2LDBHRPKXL" />
          <script is:inline>
            window.dataLayer = window.dataLayer || []; function gtag() {dataLayer.push(arguments)}; gtag("js", new
            Date()); gtag("config", "G-2LDBHRPKXL");
          </script>

          <script is:inline src="https://cdn.ingest-lr.com/LogRocket.min.js" crossorigin="anonymous" />
          <script is:inline>window.LogRocket && window.LogRocket.init('rbbdow/test');</script>
        </>
      )
    }
  </head>
  <body>
    <Progressbar />

    <main>
      <p class="version not-important">마지막 수정일: {meta.updated}</p>

      {
        sections.map((section) => {
          if (section.type === 'content') {
            return <Fragment set:html={section.html} />;
          }

          return (
            <>
              <h2>{section.title}</h2>
              <Fragment set:html={section.html} />
              {section.items?.map((item, index) => (
                <Accordion title={item.title} active={index === 0}>
                  <Fragment set:html={item.html} />
                </Accordion>
              ))}
            </>
          );
        })
      }
    </main>
  </body>
</html>
